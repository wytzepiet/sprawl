{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The UI's ink, `~ui`.
    "paths": {
      "~ui": ["./ui/index.tsx"]
    },

    // Type Checking & Safety
    "strict": true,
    "noUnusedLocals": true,
    // bun-types and vite/client disagree about import.meta; that is theirs.
    "skipLibCheck": true,
    "types": ["vite/client", "bun-types", "@webgpu/types"]
  }
}
